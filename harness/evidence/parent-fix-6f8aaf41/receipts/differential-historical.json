    "claude-responses-compact": {
      "kind": "later-reference",
      "evidence": "Go v8.0.35 (ae3ee3be) serves /v1/responses/compact for Claude (internal/runtime/executor/helps/antigravity_compaction.go); v8.0.10 answered 501. Both sides are recorded goldens: harness/expectations/compact-claude.v8.0.10.json (Go v8.0.10) and compact-claude.v8.0.35.json (Go v8.0.35, recorded with harness/run --target policy --golden). The selective target also compares the case against v8.0.67."
    },
    "cors-expose-etag": {
      "kind": "later-reference",
      "evidence": "Go v8.0.35 (ae3ee3be) internal/api/server_middleware.go:33 adds ETag to Access-Control-Expose-Headers; v8.0.10 (6fecc6e) lacks it, v8.0.67 keeps it."
    },
    "go-openai-model-order": {
      "kind": "nondeterministic",
      "evidence": "Go internal/registry/model_registry.go buildAvailableModelsLocked ranges over the r.models map, so /v1/models (OpenAI format) has no stable order."
    }

{
  "schema": 1,
  "about": "The one revision manifest for local acceptance (issue #67, H1). Every Go, first-party and toolchain pin the harness uses is here; harness/manifest.py validates it. Historical, policy and selective Go targets are separate entries: none of them is a relabelled copy of another, and old goldens keep their own recorded versions.",
  "toolchain": {
    "rust": "1.99.0",
    "rust_source": ".github/workflows/ci.yml env.RUST_TOOLCHAIN",
    "go_minimum": "1.26.10",
    "go_source": "go.mod of the newest Go target (8bba7a77)"
  },
  "go": {
    "repository": "https://github.com/router-for-me/CLIProxyAPI",
    "targets": {
      "historical": {
        "tag": "v8.0.10",
        "commit": "6fecc6e5567912661654a4eaf9b8f5436facd1c2",
        "role": "historical-recording",
        "executed": true,
        "suite": "claude-differential",
        "about": "The revision the 50-case Claude wire collector was built against (harness/evidence/2026-10-02*.json.gz). Detects unintended regressions against that recording; it is not current-provider proof."
      },
      "policy": {
        "tag": "v8.0.35",
        "commit": "ae3ee3be303fb07fb8173279923413005bf32177",
        "role": "frozen-default-reference",
        "executed": false,
        "suite": null,
        "about": "AGENTS.md's frozen default reference for non-Codex behaviour. Go goldens under crates/*/tests/fixtures carry their own recorded versions; the harness does not run this revision and does not relabel any golden to it."
      },
      "selective": {
        "tag": "v8.0.67",
        "commit": "8bba7a77c6bcbfd993516d26606bfecaa4ff49d0",
        "role": "selective-comparison",
        "executed": true,
        "suite": "selective-differential",
        "about": "The selective upstream target of docs/SELECTIVE-UPSTREAM-PLAN.md. Comparing against it does not adopt it: a difference is either a named expected divergence (pending feature, provider-first decision or harness boundary) or a failure."
      }
    }
  },
  "contracts": {
    "codex": {
      "authority": "docs/codex/CONTRACT.md",
      "repository": "https://github.com/openai/codex",
      "commit": "44ccf394573cabb95e1f751a59f9d76f6f79faf1",
      "manifest": "crates/cpa-exec/tests/fixtures/codex_contract/manifest.json",
      "constant": "crates/cpa-exec/src/codex_contract.rs FIRST_PARTY_COMMIT",
      "about": "Go behaviour never decides a Codex payload, transport or identity; Codex has no Go differential group."
    }
  },
  "suites": {
    "claude-differential": {
      "about": "harness/fixtures.py cases(): the historical 50 Claude scenarios over the TLS collector.",
      "count": 50
    },
    "selective-differential": {
      "about": "The 50 Claude scenarios plus harness/fixtures.py selective_cases(): Grok and Muse over a plain-HTTP loopback upstream. TLS fingerprint emulation is not compared for them.",
      "count": 62
    }
  },

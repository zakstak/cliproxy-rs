  "divergences": [
    {
      "id": "downstream-header-framing",
      "kind": "documented-difference",
      "targets": [
        "historical",
        "selective"
      ],
      "cases": [
        "*"
      ],
      "paths": [
        "/downstream/\\d+/headers(/.*)?",
        "/downstream/\\d+/raw_response_hex"
      ],
      "reason": "Go net/http writes canonical-case field names sorted by name; cliproxy-rs (hyper) writes lowercase names in handler order. RFC 9110 field names are case-insensitive and the order of different field names carries no meaning. The downstream-headers assertion still compares every field value case-insensitively, and downstream-body-bytes compares the body byte for byte, so this names only the raw head and its framing.",
      "ledger": "docs/DIFFERENCES-FROM-GO.md \"Response header field-name case and order\""
    },
    {
      "id": "upstream-generated-request-ids",
      "kind": "nondeterministic",
      "targets": [
        "historical",
        "selective"
      ],
      "cases": [
        "*"
      ],
      "paths": [
        "/upstream/http/\\d+/headers/\\d+/1",
        "/upstream/http/\\d+/raw_head_hex"
      ],
      "reason": "x-client-request-id is minted per request (manifest generated_headers.upstream). Raw header value paths are named here; the upstream-headers assertion compares every other header name, value, case and position exactly unless a narrower divergence names that field."
    },
    {
      "id": "credential-refresh-timestamps",
      "kind": "nondeterministic",
      "targets": [
        "historical",
        "selective"
      ],
      "cases": [
        "upstream-401",
        "refresh-expired"
      ],
      "paths": [
        "/credential_after/(expired|last_refresh)"
      ],
      "may_be_absent": true,
      "reason": "Both proxies persist the scripted token rotation; expiry and last_refresh are wall-clock times of that refresh and can fall in different seconds."
    },
    {
      "id": "cors-expose-etag",
      "kind": "later-reference",
      "targets": [
        "historical"
      ],
      "cases": [
        "*"
      ],
      "header_names": [
        "access-control-expose-headers"
      ],
      "evidence": "Go v8.0.35 (ae3ee3be) internal/api/server_middleware.go:33 adds ETag to Access-Control-Expose-Headers; v8.0.10 (6fecc6e) lacks it. v8.0.67 keeps it (no difference on the selective target).",
      "reason": "cliproxy-rs follows the v8.0.35 policy reference, not the v8.0.10 recording."
    },
    {
      "id": "claude-responses-compact",
      "kind": "later-reference",
      "targets": [
        "historical"
      ],
      "cases": [
        "compact-claude"
      ],
      "paths": [
        "/downstream/\\d+/(status|reason|body_hex|body_text)",
        "/upstream/(http|tls)(/.*)?"
      ],
      "assertions": [
        "status",
        "content-type",
        "upstream-traffic",
        "request-lines",
        "upstream-headers",
        "upstream-body-bytes",
        "upstream-body-meaning",
        "downstream-body-bytes",
        "downstream-meaning"
      ],
      "header_names": [
        "content-length",
        "content-type"
      ],
      "evidence": "Go v8.0.35 (ae3ee3be) internal/runtime/executor/helps/antigravity_compaction.go answers /v1/responses/compact for Claude with a cpa-ag-compact-v1 capsule; v8.0.10 answered 501. v8.0.67 answers 200 the same way (selective target).",
      "reason": "cliproxy-rs serves Claude Responses compaction as v8.0.35 does; the v8.0.10 recording predates it."
    },
    {
      "id": "compaction-capsule-generated",
      "kind": "nondeterministic",
      "targets": [
        "selective"
      ],
      "cases": [
        "compact-claude"
      ],
      "paths": [
        "/downstream/\\d+/body_(hex|text)"
      ],
      "assertions": [
        "downstream-body-bytes",
        "downstream-meaning"
      ],
      "reason": "The compaction answer's response and item IDs, created_at and encrypted capsule are minted per request (random nonce)."
    },
    {
      "id": "C1-claude-client-profile",
      "kind": "pending-feature",
      "issue": "https://github.com/zakstak/cliproxy-rs/issues/69",
      "targets": [
        "selective"
      ],
      "cases": [
        "*"
      ],
      "except_cases": [
        "xai-*",
        "meta-*"
      ],
      "paths": [
        "/upstream/http/\\d+/headers/\\d+/1",
        "/upstream/http/\\d+/raw_head_hex",
        "/upstream/http/\\d+/body_(hex|text)"
      ],
      "upstream_header_names": [
        "user-agent",
        "x-stainless-package-version",
        "x-stainless-runtime-version",
        "anthropic-beta"
      ],
      "upstream_body_patterns": [
        "cc_version=[0-9.]+\\.[0-9a-f]+; cc_entrypoint=cli; cch=[0-9a-f]+;"
      ],
      "reason": "v8.0.67 (b4e7dbd2) sends the Claude Code 2.1.321 tuple: User-Agent, Stainless package 0.128.0 and runtime v26.12.1, a reordered anthropic-beta list and the matching billing-header cc_version/cch. cliproxy-rs keeps 2.1.280 until C1 obtains wire evidence. Only those header fields and the billing-header version fragment are masked; every other upstream byte is compared."
    },
    {
      "id": "K1-claude-catalog",
      "kind": "pending-feature",
      "issue": "https://github.com/zakstak/cliproxy-rs/issues/68",
      "targets": [
        "selective"
      ],
      "cases": [
        "models-openai",
        "models-anthropic",
        "models-anthropic-ua"
      ],
      "paths": [
        "/downstream/\\d+/body_(hex|text)"
      ],
      "assertions": [
        "downstream-body-bytes",
        "downstream-meaning"
      ],
      "header_names": [
        "content-length"
      ],
      "reason": "v8.0.67 lists claude-fable-5-2; cliproxy-rs's embedded catalog does not yet."
    },
    {
      "id": "claude-cloak-tool-alias",
      "kind": "unclassified",
      "issue": "https://github.com/zakstak/cliproxy-rs/issues/66",
      "targets": [
        "selective"
      ],
      "cases": [
        "cloak-tools-beta",
        "tool-roundtrip",
        "tool-stream-roundtrip"
      ],
      "paths": [
        "/downstream/\\d+/body_(hex|text)"
      ],
      "upstream_body_patterns": [
        "mcp__[a-z]+_[a-z]+__[a-z]+_fixture_lookup"
      ],
      "assertions": [
        "upstream-body-meaning",
        "downstream-body-bytes",
        "downstream-meaning"
      ],
      "header_names": [
        "content-length"
      ],
      "reason": "v8.0.67 derives a different cloak alias for the same client key and tool (mcp__drive_trade__cycle_fixture_lookup instead of v8.0.10's mcp__poem_real__leisure_fixture_lookup), in the upstream tools, tool_choice and history. The scripted reply carries the v8.0.10 alias, so only cliproxy-rs restores the caller's name. The Go commit and the owning issue are not yet identified."
    },
    {
      "id": "claude-tls-connection-reuse",
      "kind": "unclassified",
      "issue": "https://github.com/zakstak/cliproxy-rs/issues/66",
      "targets": [
        "selective"
      ],
      "cases": [
        "continuity-two-turns",
        "upstream-401"
      ],
      "paths": [
        "/upstream/tls/length",
        "/upstream/tls/\\d+(/.*)?"
      ],
      "reason": "v8.0.67 opens a new TLS connection for a later request on the same credential where v8.0.10 and cliproxy-rs reuse the kept-alive one. The ClientHello profile of every handshake both sides make is identical. Candidate owner: P2 per-account connection pools (#107, deferred)."
    },
    {
      "id": "credential-disabled-persist",
      "kind": "unclassified",
      "issue": "https://github.com/zakstak/cliproxy-rs/issues/66",
      "targets": [
        "selective"
      ],
      "cases": [
        "client-disconnect"
      ],
      "paths": [
        "/credential_after/disabled"
      ],
      "may_be_absent": true,
      "reason": "After the client abandons the stream, v8.0.10 and cliproxy-rs persist the credential with disabled: false; v8.0.67 leaves the file as written. Unknown fields survive on both."
    },
    {
      "id": "plain-upstream-host-label",
      "kind": "harness-boundary",
      "targets": [
        "selective"
      ],
      "cases": [
        "xai-*",
        "meta-*"
      ],
      "paths": [
        "/upstream/http/\\d+/headers/\\d+/1",
        "/upstream/http/\\d+/raw_head_hex"
      ],
      "upstream_header_names": [
        "host"
      ],
      "reason": "Each proxy's configured base URL names its own loopback address (127.0.0.2 for Go, 127.0.0.3 for Rust) so captures stay labelled; Host differs by construction."
    },

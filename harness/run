#!/usr/bin/env bash
# Usage: harness/run [--target historical|selective] [differential.py options]
#        harness/run --target policy --golden   # record golden_cases only (never acceptance)
# The Go revision comes from harness/manifest.json; the default target is the
# historical v8.0.10 recording the 50 Claude cases were built against.
set -euo pipefail
cd "$(dirname "$0")/.."
root=$PWD
cache=$root/harness/.cache
mkdir -p "$cache"
target=historical
golden=()
args=()
while (($#)); do
    case $1 in
        --golden) golden=(--golden); args+=("$1"); shift ;;
        --target) target=${2:?--target needs a value}; shift 2 ;;
        --target=*) target=${1#--target=}; shift ;;
        *) args+=("$1"); shift ;;
    esac
done
for command in go cargo cmake clang perl python3 openssl unshare ip mount; do
    command -v "$command" >/dev/null || { echo "Missing prerequisite: $command" >&2; exit 2; }
done
pins=$(python3 harness/manifest.py shell "$target" "${golden[@]}") || exit 2
eval "$pins"
# The historical checkout keeps its original location; every other target has its own.
# CPA_GO_REFERENCE overrides the historical checkout, CPA_GO_REFERENCE_SELECTIVE the
# selective one. Either must already be clean at the pinned revision.
if [[ $target == historical ]]; then
    reference=${CPA_GO_REFERENCE:-$cache/CLIProxyAPI}
else
    override=CPA_GO_REFERENCE_${target^^}
    reference=${!override:-$cache/CLIProxyAPI-${go_commit:0:8}}
fi
# Downloads/builds happen before isolation. No provider credentials are used.
if [[ ! -e "$reference/.git" ]]; then
    git clone "$go_repository" "$reference"
    git -C "$reference" -c advice.detachedHead=false checkout "$go_commit"
fi
[[ $(git -C "$reference" rev-parse HEAD) == "$go_commit" ]] || {
    echo "Go reference $reference must be at $go_commit ($go_tag)" >&2; exit 2;
}
[[ -z $(git -C "$reference" status --porcelain) ]] || {
    echo "Go reference $reference has modifications or untracked files" >&2; exit 2;
}
binary=$cache/go-${go_commit:0:8}
(cd "$reference"; GOMAXPROCS=${GOMAXPROCS:-6} go build -o "$binary" ./cmd/server)
[[ -z $(git -C "$reference" status --porcelain) ]] || {
    echo "Building the Go reference modified $reference" >&2; exit 2;
}
python3 -m unittest discover -s harness -p 'test_*.py'
stamp=$(date +%Y%m%d-%H%M%S)
output=$cache/run-$target-$stamp
pre=$cache/provenance-$target-$stamp.json
# Builds the driver and records source, manifest and binary identity before the run.
driver=$(CARGO_BUILD_JOBS=${CARGO_BUILD_JOBS:-6} python3 harness/provenance.py pre --target "$target" \
    --go-binary "$binary" --go-reference "$reference" --out "$pre") || exit 2
# No fallback: if namespaces/mounts fail, no proxy is started. Never touch host
# /etc/hosts or its trust store. --kill-child reaps everything if interrupted.
set +e
unshare --user --map-root-user --net --mount --pid --fork --kill-child \
    bash -c 'set -euo pipefail; mount --make-rprivate /; ip link set lo up; exec python3 "$1/harness/differential.py" "$1" "${@:2}"' \
    harness "$root" --target "$target" --go-binary "$binary" --driver "$driver" --output "$output" "${args[@]}"
code=$?
set -e
[[ -f $output/summary.json ]] || { echo "collector wrote no summary (exit $code)" >&2; exit 2; }
# Confirms the same source, manifest and binaries are still current and fresh.
python3 harness/provenance.py post --pre "$pre" --run "$output" || exit 2
exit "$code"
